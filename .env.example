# Generate a long random value before deployment.
SECRET_KEY=replace-with-a-random-secret

# SQLite is sufficient for local development.
DATABASE_URL=sqlite:///database.db

# All new exam timestamps use this timezone consistently.
APP_TIMEZONE=Asia/Bangkok

# Used when the operating system has no IANA timezone database.
APP_UTC_OFFSET_HOURS=7

# Set to 1 only when the app is served over HTTPS.
COOKIE_SECURE=0

# Maximum request size in bytes. Default: 5 MB.
MAX_CONTENT_LENGTH=5242880

# Compile the generated TeX before an exam is added to the exam bank.
PDF_QUALITY_GATE=1

# Number of automatic SQLite backups retained.
BACKUP_KEEP=10

# Interval for server-side finalization of expired attempts.
ATTEMPT_SWEEP_INTERVAL_SECONDS=15

# Set to 1 only for maintenance commands or isolated tests.
DISABLE_ATTEMPT_SWEEPER=0
